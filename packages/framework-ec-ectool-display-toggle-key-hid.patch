+#define EC_CMD_DISPLAY_TOGGLE_KEY_HID 0x3E16
+
+struct ec_params_display_toggle_key_hid {
+	uint8_t enable;
+};
+
+int cmd_display_toggle_key_hid(int argc, char *argv[])
+{
+	struct ec_params_display_toggle_key_hid p;
+	char *e;
+	long enable;
+
+	if (argc != 2) {
+		fprintf(stderr, "Usage: %s <0|1>\n", argv[0]);
+		return -1;
+	}
+
+	enable = strtol(argv[1], &e, 0);
+	if ((e && *e) || (enable != 0 && enable != 1)) {
+		fprintf(stderr, "Bad display toggle HID value: %s\n", argv[1]);
+		return -1;
+	}
+
+	p.enable = enable;
+	return ec_command(EC_CMD_DISPLAY_TOGGLE_KEY_HID, 0, &p, sizeof(p),
+			  NULL, 0);
+}
